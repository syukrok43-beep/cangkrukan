---
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

// ==========================================
// 1. PENGATURAN PAGINATION (HALAMAN)
// ==========================================
const ITEMS_PER_PAGE = 12; // Jumlah berita per halaman
const currentPage = 1; // Halaman saat ini (index.astro adalah halaman 1)

// Ambil semua artikel dan urutkan berdasarkan tanggal terbaru
const semuaArtikel = (await getCollection('berita')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Hitung total halaman dan potong array sesuai halaman
const totalPages = Math.ceil(semuaArtikel.length / ITEMS_PER_PAGE);
const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
const artikelDitampilkan = semuaArtikel.slice(startIndex, startIndex + ITEMS_PER_PAGE);

// Sidebar: Ambil 5 artikel terbaru
const sidebarPosts = semuaArtikel.slice(0, 5);

// ==========================================
// 2. UTILITAS & SEO DATA
// ==========================================
const gambarDefault = "https://picsum.photos/seed/cangkrukan-default/600/400";
const formatTanggal = (date: Date) => new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }).format(date);
const formatTanggalISO = (date: Date) => date.toISOString();

const title = "Berita Terkini | Cangkrukan";
const description = "Kumpulan berita dan artikel terbaru seputar sejarah, budaya, dan literasi dari Cangkrukan.";
const url = "https://cangkrukan.id/berita/";

// Schema Markup JSON-LD Khusus Halaman Indeks Berita (SEO Ekstrem)
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${url}#webpage`,
      "url": url,
      "name": title,
      "description": description,
      "isPartOf": { "@id": "https://cangkrukan.id/#website" },
      "inLanguage": "id-ID"
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${url}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://cangkrukan.id/" },
        { "@type": "ListItem", "position": 2, "name": "Berita", "item": url }
      ]
    },
    {
      "@type": "ItemList",
      "@id": `${url}#itemlist`,
      "itemListElement": artikelDitampilkan.map((post, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "url": `https://cangkrukan.id/berita/${post.id}`,
        "name": post.data.title
      }))
    }
  ]
};
---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  
  <!-- SEO Meta Tags -->
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="theme-color" content="#AD120A" />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:locale" content="id_ID" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={url} />
  <meta property="og:site_name" content="Cangkrukan" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <style>
    /* ========================================================
       RESET & BASE STYLES
       ======================================================== */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    
    html {
      scroll-behavior: smooth;
    }
    
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: #ffffff;
      color: #111111;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
      width: 100%;
      max-width: 100vw;
      overflow-x: hidden;
    }
    
    a {
      text-decoration: none;
      color: inherit;
      transition: color 0.2s ease;
    }
    
    img {
      display: block;
      max-width: 100%;
      height: auto;
      background-color: #f0f0f0;
    }

    /* ========================================================
       LAYOUT CONTAINER & GRID
       ======================================================== */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px 16px;
    }

    .main-grid {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 40px;
      margin-top: 24px;
      align-items: start;
    }

    /* ========================================================
       HEADER KATEGORI
       ======================================================== */
    .page-header {
      border-bottom: 2px solid #111;
      padding-bottom: 16px;
      margin-bottom: 32px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 16px;
    }

    .page-title {
      font-size: 32px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: -0.5px;
      line-height: 1.1;
      margin: 0;
      color: #111;
    }

    .page-subtitle {
      font-size: 14px;
      color: #666;
      margin-top: 8px;
      font-weight: 400;
    }

    .page-count {
      font-size: 12px;
      font-weight: 700;
      background: #f5f5f5;
      padding: 6px 12px;
      border-radius: 4px;
      color: #333;
    }

    /* ========================================================
       GRID DAFTAR BERITA UTAMA
       ======================================================== */
    .news-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 32px 24px;
      width: 100%;
    }
    
    .news-card {
      display: flex;
      flex-direction: column;
      width: 100%;
      background: #fff;
      border-radius: 4px;
    }
    
    .news-card-img-wrapper {
      width: 100%;
      overflow: hidden;
      border-radius: 4px;
      margin-bottom: 16px;
      background-color: #f0f0f0;
    }

    .news-card img {
      width: 100%;
      aspect-ratio: 16/9;
      object-fit: cover;
      transition: opacity 0.3s ease;
    }
    
    .news-card:hover img {
      opacity: 0.9;
    }
    
    .news-card-cat {
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #AD120A;
      margin-bottom: 8px;
      display: inline-block;
    }
    
    .news-card-title {
      font-size: 20px;
      font-weight: 800;
      line-height: 1.35;
      margin-bottom: 12px;
      color: #111;
      letter-spacing: -0.3px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    
    .news-card:hover .news-card-title {
      color: #AD120A;
    }
    
    .news-card-desc {
      font-size: 14px;
      color: #555;
      line-height: 1.6;
      margin-bottom: 16px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    
    .news-card-meta {
      font-size: 12px;
      color: #777;
      font-weight: 500;
      margin-top: auto;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .news-card-meta strong {
      color: #111;
      font-weight: 600;
    }

    /* ========================================================
       SIDEBAR
       ======================================================== */
    .sidebar-wrapper {
      position: sticky;
      top: 40px;
    }
    
    .sidebar-section {
      margin-bottom: 40px;
    }

    .sidebar-title {
      font-size: 18px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 3px solid #AD120A;
      padding-bottom: 10px;
      margin-bottom: 20px;
      color: #111;
    }
    
    .sidebar-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    
    .sidebar-item {
      display: flex;
      gap: 16px;
      align-items: flex-start;
      padding-bottom: 16px;
      border-bottom: 1px solid #eee;
    }
    
    .sidebar-item:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }
    
    .sidebar-item img {
      width: 90px;
      height: 70px;
      object-fit: cover;
      border-radius: 4px;
      flex-shrink: 0;
    }
    
    .sidebar-info {
      flex: 1;
      min-width: 0;
    }
    
    .sidebar-item-title {
      font-size: 14px;
      font-weight: 700;
      line-height: 1.4;
      margin-bottom: 6px;
      color: #111;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    
    .sidebar-item:hover .sidebar-item-title {
      color: #AD120A;
    }
    
    .sidebar-meta {
      font-size: 11px;
      color: #777;
      text-transform: uppercase;
      font-weight: 600;
      display: block;
    }

    /* ========================================================
       WIDGET IKLAN
       ======================================================== */
    .widget-ad {
      background: #f9faf9;
      border: 1px dashed #ccc;
      height: 250px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #999;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 2px;
      border-radius: 4px;
      margin-bottom: 32px;
    }

    /* ========================================================
       PAGINATION (NAVIGASI HALAMAN)
       ======================================================== */
    .pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      margin-top: 60px;
      padding-top: 32px;
      border-top: 1px solid #eee;
    }

    .page-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      font-size: 14px;
      font-weight: 600;
      color: #111;
      background: #f5f5f5;
      border-radius: 4px;
      transition: all 0.2s;
    }

    .page-btn:hover {
      background: #e5e5e5;
    }

    .page-btn.active {
      background: #AD120A;
      color: #fff;
    }

    .page-btn.disabled {
      background: #fff;
      color: #ccc;
      cursor: not-allowed;
    }

    .page-text {
      font-size: 13px;
      font-weight: 600;
      color: #555;
      margin: 0 12px;
    }

    /* ========================================================
       RESPONSIVE DESIGN
       ======================================================== */
    
    /* Laptop Kecil / Tablet Landscape */
    @media (max-width: 1024px) {
      .main-grid {
        grid-template-columns: 1fr;
      }
      
      .sidebar-wrapper {
        position: static;
      }
      
      .news-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    /* Tablet Portrait / HP Besar */
    @media (max-width: 768px) {
      .page-header {
        flex-direction: column;
        align-items: flex-start;
      }

      .page-title {
        font-size: 26px;
      }

      .news-grid {
        grid-template-columns: 1fr;
      }
      
      .news-card-title {
        font-size: 18px;
      }

      .pagination {
        flex-wrap: wrap;
      }
    }

    /* HP Kecil */
    @media (max-width: 480px) {
      .container {
        padding: 16px 12px;
      }

      .page-title {
        font-size: 22px;
      }

      .news-card-title {
        font-size: 16px;
      }
      
      .news-card-desc {
        font-size: 13px;
      }

      .sidebar-item img {
        width: 70px;
        height: 50px;
      }
    }

    /* Aksesibilitas: Mengurangi Animasi jika diminta OS */
    @media (prefers-reduced-motion: reduce) {
      * {
        transition: none !important;
        animation: none !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>
<body>
  <Header />
  
  <main class="container">
    
    <!-- BREADCRUMB -->
    <nav aria-label="Breadcrumb" style="font-size: 12px; color: #666; margin-bottom: 16px; display: flex; gap: 8px;">
      <a href="/" style="font-weight: 600; color: #111;">Beranda</a>
      <span>/</span>
      <span style="color: #AD120A; font-weight: 600;">Berita</span>
    </nav>

    <div class="main-grid">
      
      <!-- ==================== KOLOM KIRI: DAFTAR BERITA ==================== -->
      <div class="main-content">
        
        <!-- HEADER HALAMAN -->
        <header class="page-header">
          <div>
            <h1 class="page-title">Berita Terkini</h1>
            <p class="page-subtitle">Kumpulan informasi, literasi, dan dinamika mahasiswa.</p>
          </div>
          <div class="page-count">
            Total {semuaArtikel.length} Artikel
          </div>
        </header>

        <!-- GRID BERITA -->
        {artikelDitampilkan.length > 0 ? (
          <div class="news-grid">
            {artikelDitampilkan.map((post) => (
              <a href={`/berita/${post.id}`} class="news-card" aria-label={`Baca artikel: ${post.data.title}`}>
                
                <div class="news-card-img-wrapper">
                  <img 
                    src={post.data.image || gambarDefault} 
                    alt={`Ilustrasi artikel ${post.data.title}`} 
                    width="600" 
                    height="338"
                    loading="lazy"
                    decoding="async"
                  />
                </div>

                <div class="news-card-body">
                  <span class="news-card-cat">{post.data.category} • {post.data.daerah}</span>
                  <h2 class="news-card-title">{post.data.title}</h2>
                  
                  {post.data.description && (
                    <p class="news-card-desc">{post.data.description}</p>
                  )}

                  <div class="news-card-meta">
                    <strong>{post.data.author}</strong>
                    <span>•</span>
                    <time datetime={formatTanggalISO(post.data.date)}>{formatTanggal(post.data.date)}</time>
                  </div>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div style="padding: 40px; text-align: center; background: #f9f9f9; border-radius: 8px;">
            <h3 style="font-size: 18px; color: #333;">Belum ada artikel yang dipublikasikan.</h3>
          </div>
        )}

        <!-- PAGINATION (Hanya muncul jika halaman lebih dari 1) -->
        {totalPages > 1 && (
          <nav class="pagination" aria-label="Navigasi Halaman">
            <span class="page-btn disabled" aria-hidden="true">←</span>
            {Array.from({ length: totalPages }).map((_, i) => {
              const pageNum = i + 1;
              const isActive = pageNum === currentPage;
              const pageUrl = pageNum === 1 ? '/berita/' : `/berita/page/${pageNum}`;
              
              return (
                <a 
                  href={pageUrl} 
                  class={`page-btn ${isActive ? 'active' : ''}`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {pageNum}
                </a>
              );
            })}
            <span class="page-btn disabled" aria-hidden="true">→</span>
          </nav>
        )}

      </div>

      <!-- ==================== KOLOM KANAN: SIDEBAR ==================== -->
      <aside class="sidebar-wrapper" aria-label="Sidebar">
        
        <div class="widget-ad">
          ADVERTISEMENT
        </div>

        <div class="sidebar-section">
          <h3 class="sidebar-title">Terpopuler</h3>
          <div class="sidebar-list">
            {sidebarPosts.map((post) => (
              <a href={`/berita/${post.id}`} class="sidebar-item" aria-label={`Baca artikel populer: ${post.data.title}`}>
                <img 
                  src={post.data.image || gambarDefault} 
                  alt={`Thumbnail ${post.data.title}`} 
                  width="180" 
                  height="140"
                  loading="lazy"
                  decoding="async"
                />
                <div class="sidebar-info">
                  <h4 class="sidebar-item-title">{post.data.title}</h4>
                  <span class="sidebar-meta">{post.data.category} &middot; {formatTanggal(post.data.date)}</span>
                </div>
              </a>
            ))}
          </div>
        </div>

      </aside>

    </div>
  </main>
  
  <Footer />
</body>
</html>